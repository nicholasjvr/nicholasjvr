---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { about } from "../data/about";
---

<BaseLayout>
  <main id="main" class="home-main">
    <section class="intro" aria-labelledby="intro-title">
      <div>
        <p class="eyebrow">Independent projects · {about.location}</p>
        <h1 id="intro-title">Nicholas Jansen van Rensburg<span>.</span></h1>

        <div class="hero-socials" aria-label="Social profiles">
          <a
            class="social-pill"
            href={about.socials.github.url}
            target="_blank"
            rel="noreferrer"
          >
            <img
              class="avatar-thumb"
              src={about.githubAvatar}
              alt="Nicholas Jansen van Rensburg GitHub profile photo"
              width="22"
              height="22"
              loading="eager"
            />
            <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.02 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .5Z"></path>
            </svg>
            <span>GitHub · <strong>{about.handle}</strong></span>
            <span class="pill-arrow" aria-hidden="true">↗</span>
          </a>

          <a
            class="social-pill"
            href={about.socials.instagram.url}
            target="_blank"
            rel="noreferrer"
          >
            <svg class="social-icon instagram-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram · <strong>{about.handle}</strong></span>
            <span class="pill-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <p class="intro-note">
        Two products, shaped around people and the small moments that change what they can do.
        Here are the stories behind them.
      </p>
    </section>

    <section id="projects" class="projects-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title" class="section-label">Selected work</h2>
        <span class="section-label">2026 — now</span>
      </div>

      <div class="project-list">
        {projects.map((project) => (
          <a class="project-row" href={`/projects/${project.slug}/`}>
            <span class="project-index">{project.number}</span>
            <span>
              <h2>{project.name}</h2>
              <p>{project.summary}</p>
            </span>
            <span class="project-meta">{project.websiteLabel}</span>
            <span class="project-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section id="about" class="about-section" aria-labelledby="about-title">
      <div class="section-heading">
        <h2 id="about-title" class="section-label">About me</h2>
        <span class="section-label">{about.role}</span>
      </div>

      <div class="about-grid">
        <div class="about-story">
          <div class="profile-card">
            <img
              class="profile-avatar"
              src={about.githubAvatar}
              alt="Nicholas Jansen van Rensburg"
              width="64"
              height="64"
              loading="lazy"
            />
            <div class="profile-meta">
              <div class="profile-name-row">
                <strong>{about.name}</strong>
                <span class="status-badge">
                  <span class="status-dot" aria-hidden="true"></span>
                  @{about.handle}
                </span>
              </div>
              <p class="profile-tagline">"{about.githubBio}" · {about.location}</p>
              <div class="profile-socials">
                <a href={about.socials.instagram.url} target="_blank" rel="noreferrer">
                  <svg class="social-icon instagram-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                  <span>Instagram: {about.handle}</span>
                </a>
                <a href={about.socials.github.url} target="_blank" rel="noreferrer">
                  <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.02 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .5Z"></path>
                  </svg>
                  <span>GitHub: {about.handle}</span>
                </a>
              </div>
            </div>
          </div>

          <h3 class="about-headline">{about.headline}</h3>
          {about.bio.map((paragraph) => (
            <p class="about-body">{paragraph}</p>
          ))}
        </div>

        <aside class="about-stack" aria-label="Technical toolkit">
          <p class="stack-label">What I build with</p>
          <div class="stack-groups">
            {about.stackGroups.map((group) => (
              <div class="stack-group">
                <h4 class="stack-group-title">{group.category}</h4>
                <ul class="stack-list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </aside>
      </div>

      <div class="pillars-grid" aria-label="How I work">
        {about.pillars.map((pillar) => (
          <article class="pillar-card">
            <div class="pillar-header">
              <span class="project-index">{pillar.number}</span>
              <span class="timeline-category">{pillar.label}</span>
            </div>
            <h3>{pillar.title}</h3>
            <p>{pillar.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="closing-note" aria-label="Contact">
      <p>Making useful things, learning in public, and keeping a record of how the work changes.</p>
      <div class="closing-actions">
        <a class="text-link icon-text-link" href={about.socials.instagram.url} target="_blank" rel="noreferrer">
          <svg class="social-icon instagram-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>@{about.handle}</span>
        </a>
        <a class="text-link icon-text-link" href={about.socials.github.url} target="_blank" rel="noreferrer">
          <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.02 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .5Z"></path>
          </svg>
          <span>GitHub</span>
        </a>
        <a class="text-link" href={about.socials.email.url}>Get in touch <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>