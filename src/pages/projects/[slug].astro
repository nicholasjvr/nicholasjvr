---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map(({ slug }) => ({ params: { slug } }));
}

const project = projects.find(({ slug }) => slug === Astro.params.slug);

if (!project) {
  throw new Error(`Project not found: ${Astro.params.slug}`);
}
---

<BaseLayout title={`${project.name} | Nicholas Jansen van Rensburg`} description={project.description}>
  <main id="main" class="project-main">
    <section class="project-hero" aria-labelledby="project-title">
      <p class="project-kicker">Project {project.number} / Case study</p>
      <h1 id="project-title">{project.name}</h1>
      <p class="project-summary">{project.summary}</p>
    </section>

    <section class="project-details" aria-label="Project overview">
      <p class="project-description">{project.description}</p>
      <aside class="project-aside">
        <div>
          <p class="stack-label">Built with</p>
          <ul class="stack-list">
            {project.stack.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <a class="external-link" href={project.website} target="_blank" rel="noreferrer">
          Visit {project.websiteLabel} <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </section>

    <section class="architecture-section" aria-labelledby="arch-title">
      <div class="timeline-heading">
        <h2 id="arch-title" class="section-label">System architecture &amp; flow</h2>
        <span class="section-label">{project.slug === "wakatime" ? "NFC + Hardware + Cloud" : "Media + CRM + Discovery"}</span>
      </div>
      <div class="architecture-frame">
        <img
          src={`/projects/${project.slug}/flow.svg`}
          alt={`${project.name} architecture and flow diagram`}
          loading="eager"
        />
      </div>

      {project.slug === "wakatime" && (
        <div class="capsule-viewer-card">
          <div class="capsule-viewer-header">
            <span class="timeline-category">3D HARDWARE MODEL · WAKATAG CAPSULE (.GLB)</span>
            <span class="section-label">Drag to rotate · Scroll to zoom</span>
          </div>
          <model-viewer
            class="capsule-model-viewer"
            src="/projects/wakatime/waka_time_capsule.glb"
            alt="3D CAD model of the physical WakaTime NFC Capsule"
            auto-rotate
            camera-controls
            rotation-per-second="24deg"
            camera-orbit="25deg 55deg auto"
            shadow-intensity="1"
            exposure="1.05"
          ></model-viewer>
          <script
            is:inline
            type="module"
            src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"
          ></script>
        </div>
      )}
    </section>

    <section class="timeline-section" aria-labelledby="timeline-title">
      <div class="timeline-heading">
        <h2 id="timeline-title" class="section-label">The story so far</h2>
        <span class="section-label">{project.timeline.length} milestones</span>
      </div>
      <div class="timeline-list">
        {project.timeline.map((milestone) => (
          <article class="timeline-item">
            <time class="timeline-date" datetime={milestone.date}>{milestone.date}</time>
            <div>
              <span class="timeline-category">{milestone.category}</span>
              <h3>{milestone.title}</h3>
              <p>{milestone.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <a class="back-link" href="/#projects">← All projects</a>
  </main>
</BaseLayout>