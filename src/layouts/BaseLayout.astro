---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Nicholas Jansen van Rensburg | Independent projects",
  description = "Two products, and the stories behind how they are made.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Nic (Nicholas Jansen van Rensburg), home">N<span>ic</span></a>
      <nav aria-label="Main navigation">
        <a href="/#projects">Projects</a>
        <a href="mailto:nicholas241cut@gmail.com">Contact <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Nicholas Jansen van Rensburg</span>
      <a href="https://github.com/nicholasjvr" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>